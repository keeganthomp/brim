# Public; selected at BUILD time. npm run dev configures local mode automatically.
NEXT_PUBLIC_BRIM_MODE=demo

# Server-only ingestion. All are required; missing configuration returns 503.
# Apply all packages/indexer/migrations/*.sql before receiving events.
# Use Secret Manager for deployed values. Never supply treasury/session keys here.
BRIM_PROGRAM_ADDRESS=
BRIM_TRACKED_VAULTS=
SOLANA_RPC_URL=
HELIUS_WEBHOOK_AUTHORIZATION=
DATABASE_URL=
