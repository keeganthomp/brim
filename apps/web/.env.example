# Public; selected at BUILD time. npm run dev configures local mode automatically.
NEXT_PUBLIC_BRIM_MODE=demo

# Optional public link to hosted SDK setup instructions, selected at build time.
NEXT_PUBLIC_BRIM_SDK_DOCS_URL=

# Optional Live workspace. Values are public and set at build time.
# Set a fixed vault config, or use the deployed program/network and public facilitator keys.
NEXT_PUBLIC_BRIM_LIVE_VAULT_CONFIG=
NEXT_PUBLIC_BRIM_LIVE_PROGRAM_ADDRESS=
NEXT_PUBLIC_BRIM_LIVE_NETWORK=devnet
NEXT_PUBLIC_BRIM_LIVE_FEE_PAYERS=
# Use a browser-accessible RPC without private credentials.
NEXT_PUBLIC_BRIM_LIVE_RPC_URL=

# Server-only ingestion. All are required; missing configuration returns 503.
# Apply all packages/indexer/migrations/*.sql before receiving events.
# Use Secret Manager for deployed values. Never supply treasury/session keys here.
BRIM_PROGRAM_ADDRESS=
BRIM_TRACKED_VAULTS=
SOLANA_RPC_URL=
HELIUS_WEBHOOK_AUTHORIZATION=
DATABASE_URL=
# Opt-in settled on-chain data for explicitly tracked vaults.
BRIM_PUBLIC_ACTIVITY_ENABLED=false
